# Configurações do Servidor
# Valores possíveis: development, production
ENV=development
LOG_LEVEL=info

# Configurações do Backend (FastAPI)
# NOTA: esta variável NÃO é lida pelo código atualmente. A seleção do provedor
# de pacientes é feita editando a constante STRATEGY em src/routers/paciente.py
# (convenção do projeto — ver .github/copilot-instructions.md). Mantida aqui
# apenas como documentação da intenção/valor recomendado para ambiente local.
# Valores válidos para STRATEGY: "postgres", "csv"
PACIENTE_PROVIDER_TYPE=CSV

# Banco de Dados de Aplicação (para refresh tokens, histórico SAA, etc.)
# Use um caminho absoluto se necessário
APP_DB_URL=sqlite+aiosqlite:///app.db
# Alias lido pelo main.py (prioridade sobre APP_DB_URL)
SQLITE_DSN=sqlite+aiosqlite:///app.db

# Banco de Dados AGHU (PostgreSQL)
POSTGRES_DSN=postgresql+asyncpg://user:password@host:5432/db

# Banco de Dados AGHU (Oracle)
ORACLE_DSN=oracle+oracledb://user:password@host:1521/service

# Autenticação via Active Directory
AD_URL=ldap://ad.domain.local
AD_BASEDN="DC=ebserhnet,DC=gov,DC=br"
# Opcional: um usuário de serviço para pesquisar grupos. Se não for fornecido, a busca será feita com as credenciais do próprio usuário.
AD_BIND_USER=
AD_BIND_PASSWORD=

# Segurança com JWT
JWT_SECRET=SUA_CHAVE_SECRETA_SUPER_FORTE_AQUI
JWT_EXP_HOURS=24
REFRESH_TOKEN_EXP_DAYS=30
